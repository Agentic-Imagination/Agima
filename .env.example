# Optional shell convenience file. Copy to .env, edit, then `source .env`
# from the repository root. Launchers do not load this file automatically.
export AGIMA_MODEL_PATH="$PWD/models/BAGEL-7B-MoT"
export AGIMA_CHECKPOINT_PATH="$PWD/models/task-checkpoint"
export AGIMA_TRAIN_DATA="$PWD/datasets/task-training"
export AGIMA_EVAL_DATA="$PWD/datasets/task-evaluation"
export AGIMA_RUN_DIR="$PWD/runs/example"
export PYTHONPATH="$PWD${PYTHONPATH:+:$PYTHONPATH}"

# The training launcher scripts/train.py defaults to offline logging.
export WANDB_MODE=offline

# Pass checkpoint-specific decoder/K explicitly to scripts/evaluate.py.
# Keep credentials out of this example and out of Git.

# Optional defaults for direct trainer/loader use; CLI arguments take precedence.
export AGIMA_DATA_ROOT="$PWD/datasets"
export AGIMA_EXAMPLE_DATA_ROOT="$PWD/data/bagel_example"
export AGIMA_INSTRUCTIONS_DIR="$PWD/data/instructions"
export AGIMA_INFERENCE_HASH_FILE="$PWD/datasets/inference_hashes.json"
# Optional defaults for dataset preparation tools (explicit CLI paths still work).
# export AGIMA_SOURCE_DATA="$PWD/datasets/source"
# export AGIMA_PUSHT_PPO_CHECKPOINT="$PWD/models/pusht-ppo.pt"
# Set NONTURBO_PYTHON only when intentionally using that optional JPEG backend.
